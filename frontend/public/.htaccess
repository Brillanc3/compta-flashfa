# Copié automatiquement dans dist/ par Vite à chaque build.
# Gère le cache pour permettre la détection des nouvelles versions.

<IfModule mod_headers.c>
    # Assets hashés (nom contient un hash unique) : cache long immutable.
    <FilesMatch "\.(js|css|woff2?|ttf|eot|png|jpe?g|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Jamais cachés (déclaré APRÈS pour primer sur le bloc assets ci-dessus,
    # notamment pour sw.js qui matche aussi *.js).
    # index.html pointe vers les assets hashés courants ; version.json est
    # interrogé par UpdateChecker ; sw.js = service worker.
    <FilesMatch "(^index\.html$|^version\.json$|^sw\.js$|^push-subscribe\.html$)">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
