enum HostedAssetKind {
  CSS
  JS
}

model HostedSite {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  companyId   Int
  slug        String    @unique
  name        String
  description String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdById Int
  updatedById Int
  billId      Int?      @unique

  pages        HostedPage[]
  assets       HostedAsset[]
  forms        HostedForm[]
  variables    HostedVariable[]
  customRoutes HostedCustomRoute[]
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User       @relation("HostedSiteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User       @relation("HostedSiteUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  bill      Bill?      @relation(fields: [billId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

model HostedPage {
  id          Int      @id @default(autoincrement())
  siteId      Int
  route       String   @default("")
  title       String
  htmlContent String   @db.Text @default("")
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site HostedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, route])
  @@index([siteId])
}

model HostedAsset {
  id        Int             @id @default(autoincrement())
  siteId    Int
  filename  String
  kind      HostedAssetKind
  content   String          @db.Text @default("")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  site HostedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, filename])
  @@index([siteId])
}

enum HostedFormFieldType {
  TEXT
  TEXTAREA
  EMAIL
  NUMBER
  BOOLEAN
  SELECT
  RADIO
  DATE
}

enum HostedVariableKind {
  STATIC
  DYNAMIC
}

enum HostedNotificationKind {
  TEMPORARY
  PERMANENT
  BLOCKING
}

model HostedForm {
  id               Int                    @id @default(autoincrement())
  siteId           Int
  name             String
  description      String?
  isActive         Boolean                @default(true)
  opensAt          DateTime?
  closesAt         DateTime?
  maxResponses     Int?
  notifKind        HostedNotificationKind @default(TEMPORARY)
  notifTitle       String?
  notifMessage     String                 @default("Merci pour votre réponse !")
  notifDurationSec Int                    @default(5)
  discordWebhookUrl String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  site         HostedSite          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  fields       HostedFormField[]
  responses    HostedFormResponse[]
  customRoutes HostedCustomRoute[]

  @@index([siteId])
}

model HostedFormField {
  id        Int                 @id @default(autoincrement())
  formId    Int
  key       String
  label     String
  type      HostedFormFieldType
  required  Boolean             @default(false)
  options   Json?
  order     Int                 @default(0)
  createdAt DateTime            @default(now())

  form HostedForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, key])
  @@index([formId])
}

model HostedFormResponse {
  id        Int      @id @default(autoincrement())
  formId    Int
  data      Json
  isRead    Boolean  @default(false)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  form HostedForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([formId, isRead])
}

model HostedVariable {
  id            Int                @id @default(autoincrement())
  siteId        Int
  key           String
  value         String             @db.Text @default("")
  kind          HostedVariableKind @default(STATIC)
  sourceUrl     String?
  sourcePath    String?
  refreshMs     Int?
  cachedValue   String?            @db.Text
  lastFetchedAt DateTime?
  updatedAt     DateTime           @updatedAt

  site HostedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, key])
  @@index([siteId])
}

enum HostedRouteType {
  SERVICE
  FORM_RESPONSES
}

model HostedCustomRoute {
  id          Int             @id @default(autoincrement())
  siteId      Int
  key         String
  type        HostedRouteType
