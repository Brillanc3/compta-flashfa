model InventoryMovement {
  id         Int                   @id @default(autoincrement())
  createdAt  DateTime              @default(now())
  occurredAt DateTime
  companyId  Int
  logId      Int                   @unique
  type       InventoryMovementType // ADD / REMOVE
  owner      String? // ex: "action-73-0-2"
  ownerRefId Int?
  ownerRef   Inventory? @relation("InventoryMovements", fields: [ownerRefId], references: [id])

  // 🔹 Infos item
  itemCode  String // ex: "pez_cubano"
  itemLabel String? // ex: "Pez Cubano"
  quantity  Int

  // 🔹 Lien vers ton User interne (facultatif si non résolu)
  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  properName String?

  // 🔹 Metadata brute de l'item si utile (uuid, origin, etc.)
  metadata String? @db.LongText

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  log     Log     @relation(fields: [logId], references: [id], onDelete: Cascade)

