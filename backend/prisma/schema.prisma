generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Setting {
  id    String @id
  value String
}

model User {
  id                        Int                       @id @default(autoincrement())
  createdAt                 DateTime                  @default(now())
  name                      String
  username                  String                    @unique
  password                  String
  status                    UserStatus                @default(ACTIVE)
  tempPasswordToken         String?                   @unique
  tempPasswordExpiresAt     DateTime?
  characterId               Int?
  discordId                 String?
  phoneNumber               String?
  iban                      String?
  notificationPreferences   String?                   @db.LongText
  preferences               Json?
  imageUrl                  String?
  assignedContracts         AssignedContract[]        @relation("UserAssignedContracts")
  authoredBills             Bill[]                    @relation("BillAuthor")
  billableForCompanies      BillableContact[]
  authoredCalendarEvents    CalendarEvent[]           @relation("EventAuthor")
  calendarEvents            CalendarEvent[]           @relation("EventSubject")
  employments               CompanyEmployee[]
  authoredContractTemplates ContractTemplate[]        @relation("AuthoredContractTemplates")
  authoredExpenseReports    ExpenseReport[]           @relation("AuthoredExpenseReports")
  reviewedExpenseReports    ExpenseReport[]           @relation("ReviewedExpenseReports")
  fidelityCardHistory       FidelityCardHistory[]     @relation("UserPerformedActions")
  entNotifications          Notification[]            @relation("SentNotifications")
  receivedNotifications     NotificationRecipient[]   @relation("ReceivedNotifications")
  createdPartners           Partner[]                 @relation("UserCreatedPartners")
  partnerServicesRendered   PartnerServiceRendered[]
  widgets                   UserWidget[]
  companies                 Company[]                 @relation("UserCompanies")
  permissions               Permission[]              @relation("UserPermissions")
  roles                     Role[]                    @relation("UserRoles")
  inventoryMovements        InventoryMovement[]
  createdVehicles           Vehicle[]                 @relation("VehicleCreatedBy")
  updatedVehicles           Vehicle[]                 @relation("VehicleUpdatedBy")
  vehicleMovements          VehicleMovement[]
  chatOverrides             ChatChannelUserOverride[]
  chatCategoryOverrides     ChatCategoryUserOverride[]
  chatMessages              ChatMessage[]
  chatDmMessages            ChatDmMessage[]
  chatDmConversationsA      ChatDmConversation[]      @relation("DmUserA")
  chatDmConversationsB      ChatDmConversation[]      @relation("DmUserB")
  chatReadStates            ChatChannelReadState[]
  presence                  UserPresence[]
  chatReactions             ChatReaction[]
  chatPins                  ChatPinnedMessage[] @relation("ChatPinnedByUser")
  refreshSessions           RefreshSession[]
  canceledBills             Bill[]                    @relation("BillCanceledBy")
  createdCustomPages        CustomPage[]              @relation("CustomPageCreatedBy")
  updatedCustomPages        CustomPage[]              @relation("CustomPageUpdatedBy")
  updatedCustomPageVersions CustomPageVersion[]       @relation("CustomPageVersionUpdatedBy")
  customPageAccesses        CustomPageAccess[]
  accountingNotifiedBills   Bill[]                    @relation("BillAccountingNotifyUser")
  billComments              BillComment[]             @relation("BillCommentAuthor")
  clientVariableAccesses    ClientVariableAccess[]
  clientVariableValues      ClientVariableValue[]     @relation("ClientVariableValueUpdater")
  clientLinks               Client[]                  @relation("ClientLinkedUser")
  myCalendarEventsAuthor    MyCalendarEvent[]         @relation("MyCalendarAuthor")
  myCalendarInvitations     MyCalendarGuest[]
  myCalendarCategories      MyCalendarCategory[]

  createdInventories        Inventory[]               @relation("InventoryCreatedBy")
  updatedInventories        Inventory[]               @relation("InventoryUpdatedBy")

  ticketsCreated        Ticket[]                         @relation("TicketCreator")
  ticketsAssigned       Ticket[]                         @relation("TicketAssignee")
  ticketClosureRequests Ticket[]                         @relation("TicketClosureRequester")
  ticketParticipants    TicketParticipant[]
  ticketMessages        TicketMessage[]                  @relation("TicketMessageAuthor")
  rankHistoryArchives   RankHistoryArchive[]
  createdContractShares ContractShare[]                  @relation("ContractShareCreatedBy")
  sentAssignedContracts AssignedContract[]               @relation("UserSentAssignedContracts")
  contractSignatures    ContractSignature[]              @relation("UserContractSignatures")
  electronicSignatures  UserElectronicSignatureVersion[]
  quizzes               QuizSession[]                    @relation("UserQuizzes")
  sentQuizzes           QuizSession[]                    @relation("AdminQuizzes")
  announcements         Announcement[]                   @relation("AnnouncementAuthor")

  createdHostedSites  HostedSite[] @relation("HostedSiteCreatedBy")
  updatedHostedSites  HostedSite[] @relation("HostedSiteUpdatedBy")

  // TchatV2
  ownedV2Guilds  V2Guild[]     @relation("V2GuildOwner")
  v2Members      V2Member[]    @relation("V2Members")
  v2Messages     V2Message[]   @relation("V2Messages")
  v2Reactions    V2Reaction[]  @relation("V2Reactions")
  v2Invites      V2Invite[]    @relation("V2Invites")
  v2Bans         V2Ban[]       @relation("V2Bans")
  v2Webhooks     V2Webhook[]   @relation("V2Webhooks")
  v2AuditLogs    V2AuditLog[]  @relation("V2AuditLogs")
  v2ReadStates   V2ChannelReadState[] @relation("V2ChannelReadStates")
  v2MessageEdits    V2MessageEdit[]   @relation("V2MessageEdits")
  chatMessageEdits  ChatMessageEdit[] @relation("ChatMessageEdits")
  v2PushSubscriptions V2PushSubscription[] @relation("V2PushSubscriptions")
  v2DmRecipients      V2DmRecipient[]      @relation("V2DmRecipients")
  v2PollVotes         V2PollVote[]         @relation("V2PollVotes")
  v2ForumSubscriptions     V2ForumSubscription[]       @relation("V2ForumSubscriptions")
  v2ForumPostSubscriptions V2ForumPostSubscription[]   @relation("V2ForumPostSubscriptions")
  v2UserChannelNotifs      V2UserChannelNotification[] @relation("V2UserChannelNotifications")
  v2GuildNotifSettings     V2GuildNotifSetting[]       @relation("V2GuildNotifSettings")

  @@unique([discordId, characterId], name: "UniqueDiscordCharacter")
}

model RefreshSession {
  id               Int       @id @default(autoincrement())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           Int
  deviceId         String
  refreshTokenHash String
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?

  @@unique([deviceId, refreshTokenHash])
  @@index([userId])
  @@index([deviceId])
}

model Company {
  id                      Int                       @id @default(autoincrement())
  name                    String                    @unique
  onboardingKey           String?                   @unique
  apiKey                  String?                   @unique
  isApiActive             Boolean                   @default(false)
  apiDeactivationReason   String?
  balance                 Decimal                   @default(0.00) @db.Decimal(15, 2)
  accountingPrice         Decimal                   @default(0.00) @db.Decimal(10, 2)
  pendingChanges          String?                   @db.LongText
  pendingChangesDeadline  DateTime?
  accountingSuspendedAt   DateTime?
  isParentCompany         Boolean                   @default(false)
  groupId                 Int?                      @unique
  generatedContract       AssignedContract[]        @relation("GeneratedCompany")
  contractsModifying      AssignedContract[]        @relation("CompanyModifiedByContract")
  bills                   Bill[]
  billableContacts        BillableContact[]
  calendarEvents          CalendarEvent[]
  clients                 Client[]
  employees               CompanyEmployee[]
  activeModules           CompanyModule[]
  eventCategories         EventCategory[]
  expenseReports          ExpenseReport[]
  expenseReportCategories ExpenseReportCategory[]
  fidelityCardTemplates   FidelityCardTemplate[]
  logs                    Log[]
  onboardingCodes         OnboardingCode[]
  partners                Partner[]
  partnerServicesRendered PartnerServiceRendered[]
  partnerServiceTypes     PartnerServiceType[]
  products                Product[]
  productDeclarations     ProductDeclaration[]
  ranks                   Rank[]
  roles                   Role[]                    @relation("CompanyRoles")
  transactions            Transaction[]
  userWidgets             UserWidget[]
  users                   User[]                    @relation("UserCompanies")
  inventoryMovements      InventoryMovement[]
  inventories             Inventory[]
  vehicles                Vehicle[]
  vehicleMovements        VehicleMovement[]
  channels                ChatChannel[]
  categories              ChatCategory[]
  userPresences           UserPresence[]
  contractTemplates       ContractTemplate[]        @relation("CompanyContractTemplates")
  settings                CompanySettings?
  cartonSales             CartonSale[]
  customPages             CustomPage[]
  hostedSites             HostedSite[]
  pawnshopProducts        PawnshopProduct[]
  pawnshopPartners        PawnshopPartner[]
  pawnshopPurchases       PawnshopPurchase[]
  pawnshopPartnerPrices   PawnshopPartnerBuyPrice[]
  pawnshopEstimations     PawnshopEstimation[]
  pawnshopPublicPageConfig PawnshopPublicPageConfig?
  accountingTargetBills   Bill[]                    @relation("BillAccountingTargetCompany")
  contractShares          ContractShare[]
  sacemPosts              SacemPost[]
  streamerKeys            StreamerKey[]
  billComments            BillComment[]               @relation("CompanyBillComments")
  clientVariables         ClientVariable[]
  myCalendarEvents        MyCalendarEvent[]
  myCalendarCategories    MyCalendarCategory[]
  customServices          CustomService[]
  apiKeys                 CompanyApiKey[]
  useTchatV2              Boolean                   @default(false)
  v2Guild                 V2Guild?                  @relation("V2GuildCompany")
}

model CompanySettings {
  id        String   @id @default(cuid())
  companyId Int      @unique
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("CompanySettings")
}

model CompanyApiKey {
  id         Int       @id @default(autoincrement())
  companyId  Int
  name       String
  key        String    @unique
  scopes     Json
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

enum PresenceStatus {
  ONLINE
  IDLE
  DND
  INVISIBLE
  OFFLINE
}

enum MentionType {
  USER
  RANK
  EVERYONE
}

model UserPresence {
  userId    Int
  companyId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  status      PresenceStatus @default(OFFLINE)
  customEmoji String?        @db.VarChar(64)
  customText  String?        @db.VarChar(128)

  lastHeartbeatAt DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@id([userId, companyId])
  @@index([companyId, status])
}

model ChatMention {
  id        BigInt      @id @default(autoincrement())
  messageId BigInt
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  type     MentionType
  targetId Int?

  @@index([messageId])
  @@index([targetId, type])
}

model ChatReaction {
  messageId BigInt
  userId    Int
  emoji     String @db.VarChar(64)

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([messageId, userId, emoji])
  @@index([messageId])
}

model ChatPinnedMessage {
  id             BigInt @id @default(autoincrement())
  channelId      BigInt
  messageId      BigInt
  pinnedByUserId Int

  channel  ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  message  ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy User        @relation("ChatPinnedByUser", fields: [pinnedByUserId], references: [id])

  pinnedAt DateTime @default(now())

  @@unique([channelId, messageId])
  @@index([channelId])
}

enum ChatChannelType {
  TEXT
}

model ChatCategory {
  id        BigInt  @id
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  name     String
  position Int

  channels      ChatChannel[]
  rankOverrides ChatCategoryRankOverride[]
  userOverrides ChatCategoryUserOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatCategoryRankOverride {
  categoryId BigInt
  rankId     Int

  category ChatCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  rank     Rank         @relation(fields: [rankId], references: [id])

  allowBits BigInt @default(0)
  denyBits  BigInt @default(0)

  @@id([categoryId, rankId])
  @@index([categoryId])
}

model ChatCategoryUserOverride {
  categoryId BigInt
  userId     Int

  category ChatCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id])

  allowBits BigInt @default(0)
  denyBits  BigInt @default(0)

  @@id([categoryId, userId])
  @@index([categoryId])
}

model ChatChannel {
  id        BigInt  @id
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  categoryId BigInt?
  category   ChatCategory? @relation(fields: [categoryId], references: [id])

  name               String
  topic              String?
  position           Int
  isArchived         Boolean         @default(false)
  type               ChatChannelType @default(TEXT)
  syncedWithCategory Boolean         @default(true)

  lastMessageId BigInt?

  messages       ChatMessage[]
  attachments    ChatAttachment[]
  rankOverrides  ChatChannelRankOverride[]
  userOverrides  ChatChannelUserOverride[]
  readStates     ChatChannelReadState[]
  pinnedMessages ChatPinnedMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatMessage {
  id        BigInt      @id // Snowflake
  channelId BigInt
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  content     String           @db.MediumText
  attachments ChatAttachment[]

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  replyToId BigInt?
  replyTo   ChatMessage?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies   ChatMessage[] @relation("MessageReplies")
  mentions  ChatMention[]
  reactions ChatReaction[]
  pins      ChatPinnedMessage[]
  edits     ChatMessageEdit[]

  @@index([channelId, createdAt])
}

model ChatMessageEdit {
  id        BigInt      @id
  messageId BigInt
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  content   String      @db.MediumText
  editorId  Int
  editor    User        @relation("ChatMessageEdits", fields: [editorId], references: [id], onDelete: Restrict)
  editedAt  DateTime    @default(now())

  @@index([messageId, editedAt(sort: Desc)])
}

model ChatAttachment {
  id BigInt @id

  channelId BigInt
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  messageId BigInt
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  publicId String

  mimeType String
  byteSize Int
  width    Int?
  height   Int?
  diskPath String @db.Text

  createdAt DateTime @default(now())

  @@unique([channelId, publicId])
  @@index([channelId, createdAt])
  @@index([messageId])
}

model BillableContact {
  userId     Int
  companyId  Int
  assignedAt DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  isPrio Boolean @default(false)

  @@id([userId, companyId])
  @@unique([userId], map: "BillableContact_userId_unique")
  @@index([companyId, isPrio], map: "BillableContact_companyId_isPrio_idx")
  @@index([companyId], map: "BillableContact_companyId_fkey")
}

model Role {
  id               Int             @id @default(autoincrement())
  name             String
  companyId        Int?
  targetedByEvents CalendarEvent[] @relation("TargetedRoleEvents")
  company          Company?        @relation("CompanyRoles", fields: [companyId], references: [id], onDelete: Cascade)
  permissions      Permission[]    @relation("RolePermissions")
  users            User[]          @relation("UserRoles")

  @@unique([companyId, name])
}

model Permission {
  id     Int    @id @default(autoincrement())
  action String @unique
  roles  Role[] @relation("RolePermissions")
  users  User[] @relation("UserPermissions")
}

model CompanyEmployee {
  id                       Int                   @id @default(autoincrement())
  status                   CompanyEmployeeStatus @default(PENDING_LINK)
  failedLinkAttempts       Int                   @default(0)
  companyId                Int
  userId                   Int
  rankId                   Int
  statusUpdatedAt          DateTime?
  createdAt                DateTime              @default(now())
  linkCode                 String?               @unique
  linkCodeCreatedAt        DateTime?
  company                  Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rank                     Rank                  @relation(fields: [rankId], references: [id])
  user                     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  productDeclarations      ProductDeclaration[]
  rankHistory              RankHistory[]
  cartonSales              CartonSale[]
  authoredBills            Bill[]                @relation("BillAuthorCompanyEmployee")
  billShares               BillShare[]
  pawnshopPurchasesCreated   PawnshopPurchase[]     @relation("PawnshopPurchaseCreatedBy")
  pawnshopEstimationsCreated PawnshopEstimation[]   @relation("PawnshopEstimationCreatedBy")
  sacemParticipations      SacemParticipation[]
  salaryOverrides          EmployeeSalaryOverride[]
  hrEvents                 EmployeeHREvent[]
  hrEventsCreated          EmployeeHREvent[] @relation("HREventCreatedBy")

  @@unique([companyId, userId])
  @@index([rankId], map: "CompanyEmployee_rankId_fkey")
  @@index([userId], map: "CompanyEmployee_userId_fkey")
}

model EmployeeSalaryOverride {
  id                Int             @id @default(autoincrement())
  companyEmployeeId Int
  year              Int
  week              Int
  amount            Float
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  companyEmployee   CompanyEmployee @relation(fields: [companyEmployeeId], references: [id], onDelete: Cascade)

  @@unique([companyEmployeeId, year, week])
}

model PawnshopPartner {
  id        Int     @id @default(autoincrement())
  companyId Int
  name      String
  notes     String? @db.Text
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  prices    PawnshopPartnerBuyPrice[]
  purchases PawnshopPurchase[]
}

model PawnshopProduct {
  id        Int     @id @default(autoincrement())
  companyId Int
  name           String
  sku            String?
  isActive       Boolean @default(true)
  inventoryOwner String?

  buyPrice    Decimal @db.Decimal(10, 2)
  resalePrice Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  partnerPrices    PawnshopPartnerBuyPrice[]
  purchaseItems    PawnshopPurchaseItem[]
  estimationItems  PawnshopEstimationItem[]
}

model PawnshopPartnerBuyPrice {
  id        Int @id @default(autoincrement())
  companyId Int
  partnerId Int
  productId Int

  buyPrice  Decimal  @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt

  company Company         @relation(fields: [companyId], references: [id])
  partner PawnshopPartner @relation(fields: [partnerId], references: [id])
  product PawnshopProduct @relation(fields: [productId], references: [id])

  @@unique([partnerId, productId])
  @@index([companyId])
  @@index([partnerId])
  @@index([productId])
}

model PawnshopPurchase {
  id        Int @id @default(autoincrement())
  companyId Int
  clientId  Int

  createdByEmployeeId Int
  partnerId           Int?

  status        PawnshopPurchaseStatus  @default(DRAFT)
  paymentStatus PawnshopPaymentStatus   @default(UNPAID)

  totalBuyAmount    Decimal? @db.Decimal(10, 2)
  totalResaleAmount Decimal? @db.Decimal(10, 2)

  validatedAt  DateTime?
  canceledAt   DateTime?
  cancelReason String?   @db.Text
  paidAt       DateTime?
  notes        String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  client  Client  @relation(fields: [clientId], references: [id])

  createdByEmployee CompanyEmployee @relation("PawnshopPurchaseCreatedBy", fields: [createdByEmployeeId], references: [id])

  partner PawnshopPartner? @relation(fields: [partnerId], references: [id])

  items       PawnshopPurchaseItem[]
  estimations PawnshopEstimation[]

  @@index([companyId])
  @@index([clientId])
  @@index([createdByEmployeeId])
  @@index([partnerId])
  @@index([status])
  @@index([validatedAt])
}

model PawnshopPurchaseItem {
  id         Int @id @default(autoincrement())
  purchaseId Int
  productId  Int

  quantity Decimal @db.Decimal(10, 3)

  unitBuyPrice Decimal @db.Decimal(10, 2)
  lineTotal    Decimal @db.Decimal(10, 2)

  unitResalePrice Decimal @db.Decimal(10, 2)
  resaleLineTotal Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryId Int?
  inventory   Inventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)

  purchase PawnshopPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  PawnshopProduct  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@index([inventoryId])
}

model PawnshopEstimation {
  id                  Int                      @id @default(autoincrement())
  companyId           Int
  clientId            Int?
  createdByEmployeeId Int
  status              PawnshopEstimationStatus @default(OPEN)
  notes               String?                  @db.Text
  justificatif        String?                  @db.Text
  isPublicSubmission  Boolean                  @default(false)
  convertedPurchaseId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company             Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client              Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdByEmployee   CompanyEmployee  @relation("PawnshopEstimationCreatedBy", fields: [createdByEmployeeId], references: [id])
  convertedPurchase   PawnshopPurchase? @relation(fields: [convertedPurchaseId], references: [id], onDelete: SetNull)

  items PawnshopEstimationItem[]

  @@index([companyId])
  @@index([clientId])
  @@index([status])
}

model PawnshopEstimationItem {
  id                  Int     @id @default(autoincrement())
  estimationId        Int
  productId           Int
  quantity            Decimal @db.Decimal(10, 3)
  estimatedBuyPrice   Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  estimation PawnshopEstimation @relation(fields: [estimationId], references: [id], onDelete: Cascade)
  product    PawnshopProduct    @relation(fields: [productId], references: [id])

  @@index([estimationId])
  @@index([productId])
}

model PawnshopPublicPageConfig {
  id          Int     @id @default(autoincrement())
  companyId   Int     @unique
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  publicSlug  String  @unique
  isEnabled   Boolean @default(true)
  shopName    String?
  logoUrl     String?
  welcomeText String? @db.Text
  theme       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartonSale {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  occurredAt DateTime

  // Relations
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  transactionId Int         @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  companyEmployeeId Int
  companyEmployee   CompanyEmployee @relation(fields: [companyEmployeeId], references: [id], onDelete: Cascade)

  // Données métier
  amount               Decimal @default(0.00) @db.Decimal(15, 2)
  cartonCount          Int     @default(0)
  reason               String?
  redistributionNumber String?

  // Index (perf)
  @@index([companyId, occurredAt])
  @@index([companyEmployeeId, occurredAt])
  @@index([occurredAt])
}

model Rank {
  id                  Int                  @id @default(autoincrement())
  name                String
  position            Int
  companyId           Int
  groupRankId         Int?                 @unique
  remunerationConfig  Json?
  salaryCap           Decimal?             @db.Decimal(10, 2)
  employees           CompanyEmployee[]
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  history             RankHistory[]
  permissionTemplates PermissionTemplate[] @relation("RankPermissionTemplates")

  chatOverrides         ChatChannelRankOverride[]
  chatCategoryOverrides ChatCategoryRankOverride[]
  chatPermissionsBits   BigInt                    @default(0)
  customPageAccesses  CustomPageAccess[]
  clientVariableAccesses ClientVariableAccess[]
  v2Roles           V2Role[] @relation("V2RoleCompanyRank")

  @@unique([companyId, name])
  @@unique([companyId, position])
}

model RankHistory {
  id                Int             @id @default(autoincrement())
  assignedAt        DateTime        @default(now())
  companyEmployeeId Int
  rankId            Int?
  leaveAt           DateTime?
  rankName          String
  companyEmployee   CompanyEmployee @relation(fields: [companyEmployeeId], references: [id], onDelete: Cascade)
  rank              Rank?           @relation(fields: [rankId], references: [id])

  @@index([companyEmployeeId], map: "RankHistory_companyEmployeeId_fkey")
  @@index([rankId], map: "RankHistory_rankId_fkey")
}

model RankHistoryArchive {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Snapshot entreprise (l'entreprise peut être supprimée)
  companyId   Int?
  companyName String

  // Snapshot rang
  rankId   Int?
  rankName String

  assignedAt DateTime
  leaveAt    DateTime?

  @@index([userId, assignedAt])
  @@index([companyName])
}

model ContractTemplate {
  id        Int          @id @default(autoincrement())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  type      ContractType @default(ADMIN)
  title     String
  content   String       @db.Text

  backgroundImageUrl String?

  ownerUserId       Int?
  assignedContracts AssignedContract[]
  ownerUser         User?                   @relation("AuthoredContractTemplates", fields: [ownerUserId], references: [id])
  fields            ContractTemplateField[]

  articles ContractTemplateArticle[]

  companyId Int?
  company   Company? @relation("CompanyContractTemplates", fields: [companyId], references: [id], onDelete: Cascade)

  companyNameSnapshot String?

  @@index([ownerUserId], map: "ContractTemplate_ownerUserId_fkey")
  @@index([companyId])
  @@index([companyId, type])
}

model ContractTemplateArticle {
  id         Int @id @default(autoincrement())
  templateId Int

  title  String
  body   String @db.LongText
  params Json?
  order  Int    @default(0)

  template ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model ContractTemplateField {
  id         Int               @id @default(autoincrement())
  key        String
  fieldType  ContractFieldType @default(TEXT)
  label      String
  order      Int               @default(0)
  options    String?           @db.LongText
  templateId Int
  template   ContractTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key])
  @@index([templateId, order])
}

model AssignedContract {
  id         Int       @id @default(autoincrement())
  assignedAt DateTime  @default(now())
  signedAt   DateTime?

  refusedAt     DateTime?
  refusalReason String?   @db.Text

  publicUuid      String?   @unique
  publicEnabledAt DateTime?
  publicRevokedAt DateTime?

  status             ContractStatus @default(PENDING)
  fieldValues        String?        @db.Text
  templateId         Int
  assignedToUserId   Int
  senderUserId       Int?
  generatedCompanyId Int?
  modifiesCompanyId  Int?

  generatedCompanyNameSnapshot String?
  modifiesCompanyNameSnapshot  String?

  snapshotTitle    String?
  snapshotMarkdown String? @db.Text

  assignedToUser   User                @relation("UserAssignedContracts", fields: [assignedToUserId], references: [id], onDelete: Cascade)
  senderUser       User?               @relation("UserSentAssignedContracts", fields: [senderUserId], references: [id], onDelete: SetNull)
  generatedCompany Company?            @relation("GeneratedCompany", fields: [generatedCompanyId], references: [id])
  modifiesCompany  Company?            @relation("CompanyModifiedByContract", fields: [modifiesCompanyId], references: [id])
  template         ContractTemplate    @relation(fields: [templateId], references: [id])
  signatures       ContractSignature[]
  shareItems       ContractShareItem[]

  @@index([assignedToUserId, status])
  @@index([senderUserId, status])
  @@index([generatedCompanyId], map: "AssignedContract_generatedCompanyId_fkey")
  @@index([templateId], map: "AssignedContract_templateId_fkey")
  @@index([modifiesCompanyId])
}

model ContractShare {
  id              Int       @id @default(autoincrement())
  publicId        String    @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  revokedAt       DateTime?
  passwordHash    String?
  createdByUserId Int
  companyId       Int?

  createdByUser User                @relation("ContractShareCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  company       Company?            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items         ContractShareItem[]

  @@index([createdByUserId, createdAt])
  @@index([companyId, createdAt])
  @@index([revokedAt])
}

model ContractShareItem {
  shareId            Int
  assignedContractId Int
  order              Int @default(0)

  share            ContractShare    @relation(fields: [shareId], references: [id], onDelete: Cascade)
  assignedContract AssignedContract @relation(fields: [assignedContractId], references: [id], onDelete: Cascade)

  @@id([shareId, assignedContractId])
  @@index([assignedContractId])
  @@index([shareId, order])
}

model UserElectronicSignatureVersion {
  id        Int      @id @default(autoincrement())
  userId    Int
  svg       String   @db.LongText
  createdAt DateTime @default(now())

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  contractSignatures ContractSignature[]

  @@index([userId, createdAt])
}

model CustomService {
  id            Int      @id @default(autoincrement())
  companyId     Int
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title         String
  invoiceReason String
  description   String?  @db.Text
  price         Decimal  @db.Decimal(10, 2)
  duration      String   // Ponctuel, Hebdomadaire, etc.
  startWeek     Int?
  endWeek       Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
}

model ContractSignature {
  id                   Int                   @id @default(autoincrement())
  role                 ContractSignatureRole
  signedAt             DateTime              @default(now())
  confirmationText     String
  assignedContractId   Int
  signerUserId         Int
  signatureVersionId   Int?
  signatureSvgSnapshot String?               @db.LongText
  signerNameSnapshot   String?
  signerIpAddress      String?               @db.VarChar(45)
  signerUserAgent      String?               @db.Text

  assignedContract AssignedContract                @relation(fields: [assignedContractId], references: [id], onDelete: Cascade)
  signerUser       User                            @relation("UserContractSignatures", fields: [signerUserId], references: [id], onDelete: Cascade)
  signatureVersion UserElectronicSignatureVersion? @relation(fields: [signatureVersionId], references: [id], onDelete: SetNull)

  @@unique([assignedContractId, role])
  @@index([signerUserId, signedAt])
  @@index([signatureVersionId])
}

model Notification {
  id         Int                     @id @default(autoincrement())
  content    String                  @db.LongText
  type       NotificationType
  behavior   NotificationBehavior    @default(PERMANENT)
  createdAt  DateTime                @default(now())
  senderId   Int?
  sender     User?                   @relation("SentNotifications", fields: [senderId], references: [id])
  recipients NotificationRecipient[]

  @@index([senderId], map: "Notification_senderId_fkey")
}

model NotificationRecipient {
  id             Int          @id @default(autoincrement())
  isAcknowledged Boolean      @default(false)
  notificationId Int
  userId         Int
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation("ReceivedNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId], map: "NotificationRecipient_userId_fkey")
}

model Image {
  id        Int            @id @default(autoincrement())
  publicId  String         @unique @default(cuid())
  filename  String
  mimetype  String
  byteSize  Int?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  ownerType ImageOwnerType
  ownerId   Int

  @@index([ownerId, ownerType])
}

model OnboardingCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  isUsed    Boolean   @default(false)
  companyId Int
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "OnboardingCode_companyId_fkey")
}

model Bill {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  date           DateTime
  amount         Decimal  @db.Decimal(15, 2)
  status         BillType @default(UNPAID)
  reason         String
  externalBillId Int      @unique
  issuerName     String
  recipientName  String

  authorId Int

  authorCompanyEmployeeId Int?

  companyId Int
  clientId  Int?

  canceledById Int?
  canceledBy   User? @relation("BillCanceledBy", fields: [canceledById], references: [id], onDelete: SetNull)

  author User @relation("BillAuthor", fields: [authorId], references: [id])

  authorCompanyEmployee CompanyEmployee? @relation("BillAuthorCompanyEmployee", fields: [authorCompanyEmployeeId], references: [id], onDelete: SetNull)

  client      Client?      @relation(fields: [clientId], references: [id])
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transaction Transaction?

  shares BillShare[]
  comments BillComment[]

  isParentBill Boolean @default(false)

  recipientDiscordId   String?
  recipientCharacterId Int?

  accountingTargetCompanyId Int?
  accountingTargetCompany   Company? @relation("BillAccountingTargetCompany", fields: [accountingTargetCompanyId], references: [id], onDelete: SetNull)

  accountingNotifyUserId Int?
  accountingNotifyUser   User? @relation("BillAccountingNotifyUser", fields: [accountingNotifyUserId], references: [id], onDelete: SetNull)

  accountingDueAt            DateTime?
  accountingIssuedNotifiedAt DateTime?

  accountingReminderCount  Int       @default(0)
  accountingLastReminderAt DateTime?

  hostedSite  HostedSite?

  @@index([authorId], map: "Bill_authorId_fkey")
  @@index([authorCompanyEmployeeId], map: "Bill_authorCompanyEmployeeId_fkey")
  @@index([clientId], map: "Bill_clientId_fkey")
  @@index([companyId], map: "Bill_companyId_fkey")
  @@index([canceledById], map: "Bill_canceledById_fkey")
  @@index([accountingTargetCompanyId], map: "Bill_accountingTargetCompanyId_fkey")
  @@index([accountingNotifyUserId], map: "Bill_accountingNotifyUserId_fkey")
  @@index([isParentBill, status, accountingDueAt], map: "Bill_isParentBill_status_dueAt_idx")
  @@index([companyId, createdAt(sort: Desc)])
}

model BillShare {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billId            Int
  companyEmployeeId Int

  percentage Decimal @db.Decimal(5, 2)

  bill            Bill            @relation(fields: [billId], references: [id], onDelete: Cascade)
  companyEmployee CompanyEmployee @relation(fields: [companyEmployeeId], references: [id], onDelete: Cascade)

  @@unique([billId, companyEmployeeId], map: "BillShare_bill_companyEmployee_unique")
  @@index([billId], map: "BillShare_billId_fkey")
  @@index([companyEmployeeId], map: "BillShare_companyEmployeeId_fkey")
}

model BillComment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  content   String   @db.Text

  billId    Int
  authorId  Int
  companyId Int

  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  author    User     @relation("BillCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  company   Company  @relation("CompanyBillComments", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@index([authorId])
  @@index([companyId])
}

model Transaction {
  id            Int                 @id @default(autoincrement())
  createdAt     DateTime            @default(now())
  date          DateTime
  amount        Decimal             @db.Decimal(15, 2)
  balanceBefore Decimal?            @db.Decimal(15, 2)
  balanceAfter  Decimal?            @db.Decimal(15, 2)
  description   String
  categoryId    Int
  companyId     Int
  billId        Int?                @unique
  bill          Bill?               @relation(fields: [billId], references: [id])
  category      TransactionCategory @relation(fields: [categoryId], references: [id])
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cartonSale    CartonSale?
  isCsvInjection Boolean?            @default(false)

  @@index([categoryId], map: "Transaction_categoryId_fkey")
  @@index([companyId], map: "Transaction_companyId_fkey")
  @@index([companyId, date(sort: Desc)])
}

model TransactionCategory {
  id           Int                     @id @default(autoincrement())
  name         TransactionCategoryName @unique
  type         TransactionType
  isDefault    Boolean                 @default(false)
  isDeductible Boolean                 @default(true)
  transactions Transaction[]
}

model Log {
  id                Int                @id @default(autoincrement())
  createdAt         DateTime           @default(now())
  message           String?
  category          String
  logType           String
  text              String?
  date              String
  data              String             @db.LongText
  isProcessed       Boolean            @default(false)
  processingError   String?            @db.Text
  companyId         Int
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventoryMovement InventoryMovement?
  vehicleMovement   VehicleMovement?

  @@index([companyId], map: "Log_companyId_fkey")
  @@index([category, logType])
  @@index([companyId, category, logType, date])
  @@index([companyId, createdAt(sort: Desc)])
}

model Module {
  id                  Int                  @id @default(autoincrement())
  name                String               @unique
  description         String
  companies           CompanyModule[]
  permissionTemplates PermissionTemplate[]
}

model PermissionTemplate {
  id       Int    @id @default(autoincrement())
  action   String @unique
  moduleId Int
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  ranks    Rank[] @relation("RankPermissionTemplates")

  @@index([moduleId], map: "PermissionTemplate_moduleId_fkey")
}

model CompanyModule {
  companyId Int
  moduleId  Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([companyId, moduleId])
  @@index([moduleId], map: "CompanyModule_moduleId_fkey")
}

model FidelityCardTemplate {
  id           Int                 @id @default(autoincrement())
  name         String
  isActive     Boolean             @default(true)
  baseImageId  String
  stampImageId String
  companyId    Int
  cards        FidelityCard[]
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stampZones   FidelityStampZone[]

  @@unique([companyId, name])
}

model FidelityStampZone {
  id         Int                  @id @default(autoincrement())
  x          Int
  y          Int
  order      Int
  templateId Int
  template   FidelityCardTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, order])
}

model Client {
  id                Int                    @id @default(autoincrement())
  name              String
  createdAt         DateTime               @default(now())
  phoneNumber       String?
  address           String?
  companyId         Int
  nameSearchable    String?
  cni               String?
  cniImagePublicId  String?
  iban              String?
  characterId       Int?
  discordId         String?
  userId            Int?                   // Lien optionnel vers un User (fusion client↔user)
  kind              ClientKind             @default(PERSON)
  linkedCompanyGroupId       Int?          // groupId de la company facturée (pas de FK — snapshot logique)
  linkedCompanyNameSnapshot  String?       // nom de la company au moment de la facture
  bills             Bill[]
  company           Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User?                  @relation("ClientLinkedUser", fields: [userId], references: [id], onDelete: SetNull)
  cards               FidelityCard[]
  pawnshopPurchases   PawnshopPurchase[]
  pawnshopEstimations PawnshopEstimation[]
  variableValues      ClientVariableValue[]

  @@unique([name, companyId])
  @@index([companyId], map: "Client_companyId_fkey")
  @@index([characterId])
  @@index([userId])
  @@index([linkedCompanyGroupId])
}

enum ClientKind {
  PERSON
  COMPANY
}

model FidelityCardHistory {
  id                Int                    @id @default(autoincrement())
  cardId            Int
  performedByUserId Int
  actionType        FidelityCardActionType
  beforeStampCount  Int?
  afterStampCount   Int?
  beforeStatus      FidelityCardStatus?
  afterStatus       FidelityCardStatus?
  comment           String?
  createdAt         DateTime               @default(now())
  card              FidelityCard           @relation(fields: [cardId], references: [id], onDelete: Cascade)
  performedBy       User                   @relation("UserPerformedActions", fields: [performedByUserId], references: [id])

  @@index([cardId], map: "FidelityCardHistory_cardId_fkey")
  @@index([performedByUserId], map: "FidelityCardHistory_performedByUserId_fkey")
}

model FidelityCard {
  id            Int                   @id @default(autoincrement())
  publicLink    String                @unique
  stampCount    Int                   @default(0)
  clientId      Int
  completedAt   DateTime?
  createdAt     DateTime              @default(now())
  deactivatedAt DateTime?
  status        FidelityCardStatus    @default(ACTIVE)
  templateId    Int
  updatedAt     DateTime              @updatedAt
  client        Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  template      FidelityCardTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  history       FidelityCardHistory[]

  @@index([templateId], map: "FidelityCard_templateId_fkey")
}

model Ticket {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category TicketCategory
  subject  String
  status   TicketStatus   @default(OPEN)

  createdById Int
  createdBy   User @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Cascade)

  assigneeId Int?
  assignee   User? @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  assigneeJoinedAt DateTime?
  lastMessageAt    DateTime?

  closedAt DateTime?

  closureRequestedAt   DateTime?
  closureRequestedById Int?
  closureRequestedBy   User?     @relation("TicketClosureRequester", fields: [closureRequestedById], references: [id], onDelete: SetNull)
  closureDeadlineAt    DateTime?

  participants TicketParticipant[]
  messages     TicketMessage[]

  @@index([createdById, updatedAt])
  @@index([assigneeId, updatedAt])
  @@index([category, status, updatedAt])
  @@index([status, updatedAt])
  @@index([closureDeadlineAt])
}

model TicketParticipant {
  ticketId Int
  userId   Int
  role     TicketParticipantRole @default(USER)
  joinedAt DateTime              @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
  @@index([userId])
}

model TicketMessage {
  id       Int    @id @default(autoincrement())
  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId Int
  author   User @relation("TicketMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  kind      TicketMessageKind @default(USER)
  content   String            @db.MediumText
  createdAt DateTime          @default(now())

  @@index([ticketId, createdAt])
  @@index([authorId])
}

enum TicketCategory {
  BILLS
  SUPPORT
  OTHERS
}

enum TicketStatus {
  OPEN
  ASSIGNED
  WAITING_AGENT
  WAITING_USER
  CLOSURE_REQUESTED
  CLOSED
}

enum TicketMessageKind {
  USER
  ADMIN
  SYSTEM
}

enum TicketParticipantRole {
  USER
  ADMIN
}

model Product {
  id            Int                  @id @default(autoincrement())
  createdAt     DateTime             @default(now())
  name          String
  description   String?              @db.Text
  companyId     Int
  price         Decimal              @db.Decimal(10, 2)
  isActive      Boolean              @default(true)
  deactivatedAt DateTime?
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  declarations  ProductDeclaration[]

  @@unique([companyId, name])
  @@index([companyId], map: "Product_companyId_fkey")
}

model ProductDeclaration {
  id                  Int             @id @default(autoincrement())
  createdAt           DateTime        @default(now())
  productId           Int
  companyId           Int
  employeeId          Int
  amount              Decimal         @db.Decimal(10, 2)
  declaredAt          DateTime        @default(now())
  fixedPart           Decimal?        @db.Decimal(10, 2)
  percentPart         Decimal?        @db.Decimal(5, 2)
  percentValue        Decimal?        @db.Decimal(10, 2)
  priceAtSale         Decimal?        @db.Decimal(10, 2)
  productNameSnapshot String
  quantity            Decimal         @db.Decimal(10, 2)
  company             Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee            CompanyEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  product             Product         @relation(fields: [productId], references: [id])

  @@index([companyId], map: "ProductDeclaration_companyId_fkey")
  @@index([productId], map: "ProductDeclaration_productId_fkey")
  @@index([employeeId], map: "ProductDeclaration_employeeId_fkey")
}

model WidgetDefinition {
  id                 Int           @id @default(autoincrement())
  type               String        @unique
  name               String
  description        String?
  requiredPermission String?       @db.LongText
  availableVariants  String?       @db.LongText
  targetContext      WidgetContext @default(COMPANY)
  userWidgets        UserWidget[]
}

model UserWidget {
  id                 Int              @id @default(autoincrement())
  layout             String           @db.LongText
  config             String?          @db.LongText
  userId             Int
  companyId          Int?
  widgetDefinitionId Int
  company            Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  widgetDefinition   WidgetDefinition @relation(fields: [widgetDefinitionId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "UserWidget_companyId_fkey")
  @@index([userId], map: "UserWidget_userId_fkey")
  @@index([widgetDefinitionId], map: "UserWidget_widgetDefinitionId_fkey")
}

model ExpenseReport {
  id         Int                   @id @default(autoincrement())
  amount     Decimal               @db.Decimal(10, 2)
  comment    String                @db.Text
  date       DateTime
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  status     ExpenseReportStatus   @default(PENDING)
  authorId   Int
  companyId  Int
  reviewerId Int?
  categoryId Int
  author     User                  @relation("AuthoredExpenseReports", fields: [authorId], references: [id], onDelete: Cascade)
  category   ExpenseReportCategory @relation(fields: [categoryId], references: [id])
  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reviewer   User?                 @relation("ReviewedExpenseReports", fields: [reviewerId], references: [id])

  @@index([authorId])
  @@index([companyId])
  @@index([reviewerId])
  @@index([categoryId])
  @@index([companyId, status])
}

enum ExpenseReportStatus {
  PENDING
  REIMBURSED
  REJECTED
}

model ExpenseReportCategory {
  id        Int             @id @default(autoincrement())
  name      String
  companyId Int
  reports   ExpenseReport[]
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

model EventCategory {
  id        Int             @id @default(autoincrement())
  name      String
  color     String          @default("#FFFFFF")
  companyId Int
  events    CalendarEvent[]
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
}

model CalendarEvent {
  id              Int            @id @default(autoincrement())
  title           String
  description     String?        @db.Text
  startTime       DateTime
  endTime         DateTime?
  isAllDay        Boolean        @default(false)
  rrule           String?        @db.VarChar(255)
  createdAt       DateTime       @default(now())
  createdBySystem Boolean        @default(false)
  userId          Int
  authorId        Int
  categoryId      Int?
  companyId       Int?
  targetRoleId    Int?
  author          User           @relation("EventAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  category        EventCategory? @relation(fields: [categoryId], references: [id])
  company         Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  targetRole      Role?          @relation("TargetedRoleEvents", fields: [targetRoleId], references: [id])
  user            User           @relation("EventSubject", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startTime, endTime])
  @@index([authorId])
  @@index([categoryId])
  @@index([companyId])
  @@index([targetRoleId])
}

// =============================
// Custom Pages (WordPress-like)
// =============================

enum CustomPageType {
  IFRAME
  CUSTOM
}

enum CustomPageVersionKind {
  DRAFT
  PUBLISHED
}

enum CustomPageAccessKind {
  USER
  RANK
}

model CustomPage {
  id        Int            @id @default(autoincrement())
  companyId Int
  type      CustomPageType
  slug      String
  title     String
  isPublic  Boolean        @default(false)

  // Version actuelle brouillon / publiée
  draftVersionId     Int? @unique
  publishedVersionId Int? @unique

  navTitle      String?
  navIcon       String?
  showInSidebar Boolean @default(false)
  navOrder      Int     @default(0)
  navGroup      String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdById Int
  updatedById Int

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  versions CustomPageVersion[] @relation("CustomPageToVersions")

  draftVersion     CustomPageVersion? @relation("DraftVersion", fields: [draftVersionId], references: [id], onDelete: SetNull)
  publishedVersion CustomPageVersion? @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)

  accesses CustomPageAccess[]

  createdBy User @relation("CustomPageCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("CustomPageUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([companyId, updatedAt])
  @@index([companyId, publishedAt])
  @@index([companyId, showInSidebar, navOrder])
}

model CustomPageVersion {
  id     Int                   @id @default(autoincrement())
  pageId Int
  kind   CustomPageVersionKind

  // Contenu selon type:
  // - CUSTOM  -> content
  // - IFRAME  -> iframeUrl
  content   String? @db.LongText
  iframeUrl String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById Int

  // Relation vers la page (toutes versions)
  page CustomPage @relation("CustomPageToVersions", fields: [pageId], references: [id], onDelete: Cascade)

  // Back-relations (optionnelles) si cette version est “pointeur” draft/published
  draftFor     CustomPage? @relation("DraftVersion")
  publishedFor CustomPage? @relation("PublishedVersion")

  updatedBy User @relation("CustomPageVersionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([pageId])
  @@index([pageId, kind])
  @@index([updatedById])
}

model CustomPageAccess {
  id     Int                  @id @default(autoincrement())
  pageId Int
  kind   CustomPageAccessKind

  userId Int?
  rankId Int?

  page CustomPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank Rank? @relation(fields: [rankId], references: [id], onDelete: Cascade)

  @@unique([pageId, kind, userId])
  @@unique([pageId, kind, rankId])
  @@index([pageId])
  @@index([pageId, kind])
}

