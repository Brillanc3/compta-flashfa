model MyCalendarEvent {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?  @db.Text // Markdown
  startTime       DateTime
  endTime         DateTime
  color           String?  @default("#3b82f6")
  repetition      String?  // RRule string
  
  authorId        Int
  author          User     @relation("MyCalendarAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  
  companyId       Int?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  categoryId      Int?
  category        MyCalendarCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  imageUrl        String?
  isPredefined    Boolean  @default(false)
  
  guests          MyCalendarGuest[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([authorId])
  @@index([companyId])
  @@index([startTime, endTime])
