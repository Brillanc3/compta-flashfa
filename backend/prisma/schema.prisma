enum ClientVariableType {
  BOOLEAN
  TEXT
}

model ClientVariable {
  id               Int                @id @default(autoincrement())
  companyId        Int
  slug             String             // identifiant unique par company (ex: "vip")
  label            String             // affiché dans l'UI (ex: "VIP")
  type             ClientVariableType @default(BOOLEAN)
  config           Json               @default("{}") // icônes, couleurs, textes selon valeur
  order            Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  showInPerks        Boolean            @default(false)  // Afficher dans "Mes avantages" si le client a cette variable
  showInCatalog      Boolean            @default(false)  // Afficher dans le catalogue public (indépendamment du client)
  perksDescription   String?            @db.LongText      // Description markdown affichée dans la page avantages
  perksPrice         Decimal?           @db.Decimal(10, 2)
  perksPriceDuration String?
  perksIconUrl       String?

  company  Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accesses ClientVariableAccess[]
  values   ClientVariableValue[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([companyId, order])
}

model ClientVariableAccess {
  id         Int    @id @default(autoincrement())
  variableId Int
  kind       CustomPageAccessKind // réutilise USER / RANK

  userId Int?
  rankId Int?

  variable ClientVariable @relation(fields: [variableId], references: [id], onDelete: Cascade)
  user     User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank     Rank?          @relation(fields: [rankId], references: [id], onDelete: Cascade)

  @@unique([variableId, kind, userId])
  @@unique([variableId, kind, rankId])
  @@index([variableId])
  @@index([variableId, kind])
}

model ClientVariableValue {
  id         Int      @id @default(autoincrement())
  variableId Int
  clientId   Int
  value      String?  @db.Text // NULL = non défini
  updatedAt  DateTime @updatedAt

  updatedByUserId Int?
  updatedBy       User?          @relation("ClientVariableValueUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  variable        ClientVariable @relation(fields: [variableId], references: [id], onDelete: Cascade)
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([variableId, clientId])
  @@index([clientId])
  @@index([variableId])
}

