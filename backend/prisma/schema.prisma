// Ingest Fallback (Redis KO)
// =============================

model IngestFallback {
  id         String    @id @default(uuid())
  companyId  String
  url        String    @db.Text
  method     String
  headers    Json
  bodyString String    @db.LongText
  enqueuedAt DateTime
  createdAt  DateTime  @default(now())
  attempts   Int       @default(0)
  lastError  String?   @db.Text
  resolved   Boolean   @default(false)
  resolvedAt DateTime?

  @@index([resolved, attempts])
  @@index([createdAt])
}

// =============================
// Announcements (Admin)
// =============================

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  body        String   @db.Text
  isActive    Boolean  @default(false)
  actions     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById Int
  createdBy   User     @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([createdById])
}

// =============================================================================
// TchatV2 — Coexiste avec chat V1 (tables chat_*). Préfixe v2_ garanti zéro collision.
// =============================================================================

// TASK 1.5 ─────────────────────────────────────────────────────────────────────

model V2Guild {
  id                BigInt   @id @db.BigInt
  name              String   @db.VarChar(100)
  description       String?  @db.Text
  iconHash          String?  @db.VarChar(128)
  bannerHash        String?  @db.VarChar(128)
  ownerId           Int
  owner             User     @relation("V2GuildOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  systemChannelId   BigInt?  @db.BigInt
  afkChannelId      BigInt?  @db.BigInt
  afkTimeout        Int      @default(300)
  verificationLevel Int      @default(0)
  companyId         Int?     @unique
  company           Company? @relation("V2GuildCompany", fields: [companyId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  roles    V2Role[]
  channels V2Channel[]
  members  V2Member[]
  invites  V2Invite[]
  bans     V2Ban[]
  webhooks V2Webhook[]
  auditLog      V2AuditLog[]
  emojis        V2GuildEmoji[]
  notifSettings V2GuildNotifSetting[]

  @@map("v2_guild")
}

model V2GuildEmoji {
  id        BigInt   @id @db.BigInt
  guildId   BigInt   @db.BigInt
  guild     V2Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(64)
  imageKey  String   @db.VarChar(128)
  createdAt DateTime @default(now())

  @@index([guildId])
  @@map("v2_guild_emoji")
}

model V2GuildNotifSetting {
  id         BigInt    @id @default(autoincrement()) @db.BigInt
  userId     Int
  user       User      @relation("V2GuildNotifSettings", fields: [userId], references: [id], onDelete: Cascade)
  guildId    BigInt    @db.BigInt
  guild      V2Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  level      Int       @default(0)
  mutedUntil DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, guildId])
  @@index([guildId])
  @@map("v2_guild_notif_setting")
}

model V2Role {
  id          BigInt   @id @db.BigInt
  guildId     BigInt   @db.BigInt
  guild       V2Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(100)
  color       Int      @default(0)
  hoist       Boolean  @default(false)
  position    Int      @default(0)
  permissions BigInt   @default(0) @db.BigInt
  managed       Boolean  @default(false)
  companyRankId Int?
  companyRank       Rank?    @relation("V2RoleCompanyRank", fields: [companyRankId], references: [id], onDelete: SetNull)
  mentionable   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberRoles  V2MemberRole[]

  @@index([guildId, position])
  @@map("v2_role")
}

model V2Member {
  id                    BigInt    @id @default(autoincrement()) @db.BigInt
  guildId               BigInt    @db.BigInt
  guild                 V2Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId                Int
  user                  User      @relation("V2Members", fields: [userId], references: [id], onDelete: Cascade)
  nickname              String?   @db.VarChar(32)
  avatarHash            String?   @db.VarChar(128)
  timeoutUntil          DateTime?
  cachedGuildPermissions BigInt   @default(0) @db.BigInt
  joinedAt              DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  memberRoles V2MemberRole[]

  @@unique([guildId, userId])
  @@index([guildId])
  @@index([userId])
  @@map("v2_member")
}

model V2MemberRole {
  memberId BigInt   @db.BigInt
  member   V2Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleId   BigInt   @db.BigInt
  role     V2Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@map("v2_member_role")
}

model V2Channel {
  id                BigInt    @id @db.BigInt
  guildId           BigInt?   @db.BigInt
  guild             V2Guild?  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  parentId          BigInt?   @db.BigInt
  type              Int
  name              String    @db.VarChar(100)
  topic             String?   @db.VarChar(1024)
  position          Int       @default(0)
  nsfw              Boolean   @default(false)
  rateLimitPerUser  Int       @default(0)
  lastMessageId     BigInt?   @db.BigInt
  lastPinTimestamp  DateTime?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  overwrites      V2PermissionOverwrite[]
  messages        V2Message[]
  pinnedMessages  V2PinnedMessage[]
  invites         V2Invite[]
  webhooks        V2Webhook[]
  threadMetadata  V2ThreadMetadata?
  readStates      V2ChannelReadState[]
  dmRecipients    V2DmRecipient[]       @relation("V2DmRecipients")
  forumTags       V2ForumTag[]          @relation("V2ForumTags")
  forumSubscriptions V2ForumSubscription[] @relation("V2ForumSubscriptions")
  forumPostSubscriptions V2ForumPostSubscription[] @relation("V2ForumPostSubscriptions")
  userNotifications  V2UserChannelNotification[] @relation("V2UserChannelNotifications")

  @@index([guildId, position])
  @@index([parentId])
  @@map("v2_channel")
}

model V2DmRecipient {
  id        BigInt    @id @db.BigInt
  channelId BigInt    @db.BigInt
  channel   V2Channel @relation("V2DmRecipients", fields: [channelId], references: [id], onDelete: Cascade)
  userId    Int
  user      User      @relation("V2DmRecipients", fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime  @default(now())
  hiddenAt  DateTime?

  @@unique([channelId, userId])
  @@index([userId])
  @@map("v2_dm_recipient")
}

model V2PermissionOverwrite {
  id        BigInt    @id @db.BigInt
  channelId BigInt    @db.BigInt
  channel   V2Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  // targetId pointe vers un role (type=0) ou un member (type=1) — polymorphique, sans FK Prisma
  targetId  BigInt    @db.BigInt
  type      Int
  allow     BigInt    @default(0) @db.BigInt
  deny      BigInt    @default(0) @db.BigInt

  @@unique([channelId, targetId, type])
  @@index([channelId])
  @@map("v2_permission_overwrite")
}

model V2ThreadMetadata {
  channelId           BigInt    @id @db.BigInt
  channel             V2Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  archived            Boolean   @default(false)
  autoArchiveDuration Int       @default(1440)
  archiveTimestamp    DateTime?
  locked              Boolean   @default(false)
  pinned              Boolean   @default(false)
  createMessageId     BigInt?   @db.BigInt
  deletedAt           DateTime?

  @@map("v2_thread_metadata")
}

// TASK 1.6 ─────────────────────────────────────────────────────────────────────

model V2Message {
  id                BigInt    @id @db.BigInt
  channelId         BigInt    @db.BigInt
  channel           V2Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId          Int
  author            User      @relation("V2Messages", fields: [authorId], references: [id], onDelete: Restrict)
  type              Int       @default(0)
  content           String    @db.VarChar(2000)
  editedAt          DateTime?
  pinned            Boolean   @default(false)
  tts               Boolean   @default(false)
  nonce             String?   @db.VarChar(64)
  flags             Int       @default(0)
  referencedMessageId BigInt? @db.BigInt
  deletedAt         DateTime?
  // Champs dénormalisés pour éviter les JOIN chauds
  authorUsername    String    @db.VarChar(64)
  authorAvatarHash  String?   @db.VarChar(128)
  authorNickname    String?   @db.VarChar(32)
  mentionsJson      String?   @db.Text
  reactionsSummary  String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  attachments  V2Attachment[]
  embeds       V2Embed[]
  reactions    V2Reaction[]
  mentions     V2MessageMention[]
  pinnedIn     V2PinnedMessage[]
  edits        V2MessageEdit[]
  poll         V2Poll?

  @@index([channelId, id(sort: Desc)])
  @@index([authorId])
  @@fulltext([content])
  @@map("v2_message")
}

model V2Attachment {
  id          BigInt    @id @db.BigInt
  messageId   BigInt?   @db.BigInt
  message     V2Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  filename    String    @db.VarChar(255)
  contentType String    @db.VarChar(128)
  size        Int
  url         String    @db.VarChar(512)
  key         String    @db.VarChar(512)
  width       Int?
  height      Int?
  userId      Int?      // P0.5 — propriétaire (nullable pour legacy)
  companyId   Int?      // P0.5 — tenant (nullable pour legacy)
  scanStatus  String?   @default("pending") @db.VarChar(16) // pending|confirmed|rejected
  createdAt   DateTime  @default(now())

  @@index([messageId])
  @@index([userId])
  @@index([companyId])
  @@map("v2_attachment")
}

model V2Embed {
  id          BigInt    @id @db.BigInt
  messageId   BigInt    @db.BigInt
  message     V2Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type        String    @default("rich") @db.VarChar(32)
  url         String?   @db.VarChar(512)
  title       String?   @db.VarChar(256)
  description String?   @db.Text
  color       Int?
  imageUrl    String?   @db.VarChar(512)
  thumbnailUrl String?  @db.VarChar(512)
  authorName  String?   @db.VarChar(256)
  authorUrl   String?   @db.VarChar(512)
  footerText  String?   @db.VarChar(2048)
  rawJson     String?   @db.LongText
  createdAt   DateTime  @default(now())

  @@index([messageId])
  @@map("v2_embed")
}

model V2Reaction {
  id        BigInt    @id @db.BigInt
  messageId BigInt    @db.BigInt
  message   V2Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    Int
  user      User      @relation("V2Reactions", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String    @db.VarChar(64)
  createdAt DateTime  @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("v2_reaction")
}

model V2MessageMention {
  id          BigInt    @id @db.BigInt
  messageId   BigInt    @db.BigInt
  message     V2Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  targetId    BigInt    @db.BigInt
  type        String    @db.VarChar(16)

  @@index([messageId])
  @@index([targetId, type])
  @@map("v2_message_mention")
}

model V2PinnedMessage {
  channelId BigInt    @db.BigInt
  channel   V2Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  messageId BigInt    @db.BigInt
  message   V2Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedAt  DateTime  @default(now())
  pinnedBy  Int

  @@id([channelId, messageId])
  @@index([channelId, pinnedAt(sort: Desc)])
  @@map("v2_pinned_message")
}

model V2MessageEdit {
  id        BigInt    @id @db.BigInt
  messageId BigInt    @db.BigInt
  message   V2Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  content   String    @db.VarChar(2000)
  editorId  Int
  editor    User      @relation("V2MessageEdits", fields: [editorId], references: [id], onDelete: Restrict)
  editedAt  DateTime  @default(now())

  @@index([messageId, editedAt(sort: Desc)])
  @@map("v2_message_edit")
}

// TASK 1.7 ─────────────────────────────────────────────────────────────────────

model V2Invite {
  code       String    @id @db.VarChar(16)
  guildId    BigInt    @db.BigInt
  guild      V2Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId  BigInt?   @db.BigInt
  channel    V2Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  inviterId  Int
  inviter    User      @relation("V2Invites", fields: [inviterId], references: [id], onDelete: Cascade)
  maxUses    Int       @default(0)
  uses       Int       @default(0)
  maxAge     Int       @default(86400)
  temporary  Boolean   @default(false)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([guildId])
  @@index([expiresAt])
  @@map("v2_invite")
}

model V2Ban {
  guildId   BigInt   @db.BigInt
  guild     V2Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation("V2Bans", fields: [userId], references: [id], onDelete: Cascade)
  reason    String?  @db.VarChar(512)
  createdAt DateTime @default(now())

  @@id([guildId, userId])
  @@index([guildId])
  @@map("v2_ban")
}

model V2Webhook {
  id        BigInt    @id @db.BigInt
  guildId   BigInt    @db.BigInt
  guild     V2Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId BigInt    @db.BigInt
  channel   V2Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  name      String    @db.VarChar(80)
  avatarHash String?  @db.VarChar(128)
  token     String    @db.VarChar(128)
  signingSecret String? @db.VarChar(128) // P0.2 — secret HMAC-SHA256, nullable pour webhooks legacy
  createdBy Int
  creator   User      @relation("V2Webhooks", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now())

  @@index([guildId])
  @@index([channelId])
  @@map("v2_webhook")
}

model V2AuditLog {
  id         BigInt   @id @db.BigInt
  guildId    BigInt   @db.BigInt
  guild      V2Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  actorId    Int?
  actor      User?    @relation("V2AuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  targetId   BigInt?  @db.BigInt
  actionType Int
  changes    String?  @db.LongText
  reason     String?  @db.VarChar(512)
  createdAt  DateTime @default(now())

  @@index([guildId, createdAt(sort: Desc)])
  @@index([actorId])
  @@map("v2_audit_log")
}

model V2MigrationMap {
  entityType String @db.VarChar(20)
  v1Id       String @db.VarChar(64)
  v2Id       BigInt @db.BigInt

  @@id([entityType, v1Id])
  @@index([v2Id])
  @@map("v2_migration_map")
}

model V2ChannelReadState {
  id                String   @id @default(cuid())
  userId            Int
  user              User     @relation("V2ChannelReadStates", fields: [userId], references: [id], onDelete: Cascade)
  channelId         BigInt   @db.BigInt
  channel           V2Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lastReadMessageId BigInt?  @db.BigInt
  lastReadAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, channelId])
  @@index([channelId])
  @@map("v2_channel_read_state")
}

model V2PushSubscription {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation("V2PushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  endpoint    String   @db.VarChar(500)
  p256dh      String   @db.VarChar(256)
  auth        String   @db.VarChar(64)
  deviceType  String   @default("web") @db.VarChar(20)
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([userId, endpoint])
  @@index([userId])
  @@map("v2_push_subscription")
}

model V2UserChannelNotification {
  id          BigInt    @id @default(autoincrement()) @db.BigInt
  userId      Int
  user        User      @relation("V2UserChannelNotifications", fields: [userId], references: [id], onDelete: Cascade)
  channelId   BigInt    @db.BigInt
  channel     V2Channel @relation("V2UserChannelNotifications", fields: [channelId], references: [id], onDelete: Cascade)
  level       Int       @default(0)            // 0=DEFAULT, 1=ALL, 2=MENTIONS, 3=NONE
  mutedUntil  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, channelId])
  @@index([channelId])
  @@map("v2_user_channel_notification")
}

// P2.7 ─────────────────────────────────────────────────────────────────────────

model V2ForumTag {
  id        BigInt    @id @db.BigInt
  channelId BigInt    @db.BigInt
  channel   V2Channel @relation("V2ForumTags", fields: [channelId], references: [id], onDelete: Cascade)
  name      String    @db.VarChar(64)
  emoji     String?   @db.VarChar(64)
  moderated Boolean   @default(false)
  createdAt DateTime  @default(now())

  threadTags V2ThreadTag[]

  @@index([channelId])
  @@map("v2_forum_tag")
}

model V2ThreadTag {
  threadId BigInt     @db.BigInt
  tagId    BigInt     @db.BigInt
  tag      V2ForumTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([threadId, tagId])
  @@map("v2_thread_tag")
}

model V2Poll {
  id        BigInt      @id @db.BigInt
  messageId BigInt      @unique @db.BigInt
  message   V2Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  question  String      @db.VarChar(300)
  multiple  Boolean     @default(false)
  expiresAt DateTime?
  createdAt DateTime    @default(now())

  options V2PollOption[]
  votes   V2PollVote[]

  @@map("v2_poll")
}

model V2PollOption {
  id     BigInt @id @db.BigInt
  pollId BigInt @db.BigInt
  poll   V2Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text   String @db.VarChar(100)

  votes V2PollVote[]

  @@index([pollId])
  @@map("v2_poll_option")
}

model V2PollVote {
  id       BigInt       @id @db.BigInt
  pollId   BigInt       @db.BigInt
  poll     V2Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId BigInt       @db.BigInt
  option   V2PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   Int
  user     User         @relation("V2PollVotes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([pollId, userId, optionId])
  @@index([pollId, optionId])
  @@map("v2_poll_vote")
}

model V2ForumSubscription {
  userId    Int
  user      User      @relation("V2ForumSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  channelId BigInt    @db.BigInt
  channel   V2Channel @relation("V2ForumSubscriptions", fields: [channelId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([userId, channelId])
  @@index([channelId])
  @@map("v2_forum_subscription")
}

model V2ForumPostSubscription {
  userId   Int
  threadId BigInt    @db.BigInt
  user     User      @relation("V2ForumPostSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  thread   V2Channel @relation("V2ForumPostSubscriptions", fields: [threadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, threadId])
  @@index([threadId])
  @@index([userId])
  @@map("v2_forum_post_subscription")
}
