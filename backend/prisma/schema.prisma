  @@index([companyId, occurredAt])
  @@index([companyId, userId, occurredAt])
  @@index([companyId, itemCode, occurredAt])
  @@index([companyId, properName, occurredAt])
  @@index([companyId, owner, occurredAt])
  @@index([ownerRefId])
}

model Inventory {
