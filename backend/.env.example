# ===================================================================
# CONFIGURATION BACKEND — compta-flashfa
# -------------------------------------------------------------------
# Copiez ce fichier en `.env` puis remplissez chaque valeur.
#   cp .env.example .env
#
# ⚠️  Ne commitez JAMAIS le `.env` (déjà ignoré par git).
# Voir le README.md (section « Générer les secrets ») pour les
# commandes de génération de chaque clé.
# ===================================================================

# Fuseau horaire de l'application
TZ='Europe/Paris'

# Environnement : dev | prod
ENV=dev

# -------------------------------------------------------------------
# BASE DE DONNÉES (MySQL via Prisma)
# -------------------------------------------------------------------
# Format : mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@127.0.0.1:3306/flashfa"

# Base « shadow » utilisée par Prisma pour les migrations (peut être
# une seconde base vide). Format identique à DATABASE_URL.
SHADOW_DATABASE_URL="mysql://root:password@127.0.0.1:3306/flashfa_shadow"

# -------------------------------------------------------------------
# REDIS (cache, sessions, BullMQ, adapter Socket.io)
# -------------------------------------------------------------------
# Format : redis://[:PASSWORD@]HOST:PORT
REDIS_URL="redis://127.0.0.1:6379"

# -------------------------------------------------------------------
# SECRETS / AUTH
# -------------------------------------------------------------------
# Générer chacun via :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_SECRET=
REFRESH_TOKEN_SALT=

# Liste de mots filtrés par la modération (séparés par des virgules)
PROFANITY_CUSTOM_WORDS=

# -------------------------------------------------------------------
# 🧩 IA (service local optionnel)
# -------------------------------------------------------------------
AI_LOCAL_URL=http://127.0.0.1:4050/ask
# Jeton interne d'appel au service IA (généré comme les secrets ci-dessus)
AI_INTERNAL_TOKEN=

# -------------------------------------------------------------------
# 🧩 BOT DISCORD (optionnel — monitoring des shards / rapports)
# -------------------------------------------------------------------
# Récupérez ces valeurs sur https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Salon où afficher « Shard Status »
DISCORD_STATUS_CHANNEL_ID=
# (optionnel) salon pour les /report ; sinon réutilise STATUS_CHANNEL
DISCORD_REPORT_CHANNEL_ID=
# En-tête x-report-secret pour la route /status/discord/report
DISCORD_REPORT_SECRET=

# -------------------------------------------------------------------
# 🧩 SYSTÈME DE SHARDS
# -------------------------------------------------------------------
# Niveau de log Fastify : fatal | error | warn | info | debug | trace
FASTIFY_LOG_LEVEL=debug
# Port du Master (routeur principal)
MASTER_PORT=2500
# Port du WebSocket
WEBSOCKET_PORT=2505
# Port de base à partir duquel les shards sont créés
SHARD_BASE_PORT=3000
BASE_SHARD_PORT=10000
# Temps (ms) avant extinction d'une shard inactive
SHARD_IDLE_TTL_MS=3600000
# Temps (ms) max avant qu'un shard soit considéré injoignable
SHARD_WAIT_TIMEOUT=5000
# Temps (s) d'inactivité avant suppression d'un shard
SHARD_TTL=600

# -------------------------------------------------------------------
# MINIO / S3 (stockage des fichiers & médias)
# -------------------------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=tchatv2
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# -------------------------------------------------------------------
# WEB PUSH (notifications navigateur — VAPID)
# -------------------------------------------------------------------
# Générer la paire via :
#   npx web-push generate-vapid-keys
# La clé publique doit aussi être reportée côté frontend (VITE_VAPID_PUBLIC_KEY).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com
